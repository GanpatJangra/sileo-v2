{
	"name": "sileo-v2",
	"version": "0.1.0",
	"description": "Animated, physics-based toast notifications for React with TypeScript support, promise states, actions, and customizable styling.",
	"keywords": [
		"react",
		"toast",
		"notification",
		"toaster",
		"snackbar",
		"typescript",
		"ui",
		"component",
		"animation",
		"promise"
	],
	"license": "MIT",
	"homepage": "https://github.com/GanpatJangra/sileo-v2#readme",
	"bugs": {
		"url": "https://github.com/GanpatJangra/sileo-v2/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GanpatJangra/sileo-v2.git"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"default": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": [
		"**/*.css"
	],
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && bunchee && cp src/styles.css dist/styles.css",
		"dev": "bunchee --watch",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"devDependencies": {
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"bunchee": "^6.12.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"overrides": {
		"picomatch": "^4.0.4"
	}
}
